void main(
  float4 v0 : SV_Position0,
  float4 v1 : TEXCOORD0,
  float4 v2 : TEXCOORD2, //unused
  float3 v3 : TEXCOORD1,
  out float2 o0 : SV_Target0)
{
  const float3 normal = normalize(PS_TEXTURES_2D_3_.Sample(PS_SAMPLERS_3__s, v1.xy).xyz * 2.0 - 1.0);
  const float3 viewNormal = normalize(float3(
    dot(normal, PS_REG_SSAO_MV_1.xyz),
    dot(normal, PS_REG_SSAO_MV_2.xyz),
    dot(normal, PS_REG_SSAO_MV_3.xyz)
  ));

  const float4 dither = PS_TEXTURES_2D_2_.Sample(PS_SAMPLERS_0__s, v1.zw) * 2.0 - 1.0;
  const float2 localNoise = frac(dither.xy * 0.5 + 0.5 + dither.zw * 0.125);

  const float centerDepth = PS_TEXTURES_2D_0_.Sample(PS_SAMPLERS_3__s, v1.xy).x;
  const float centerLinearDepth = 0.100000016 / (1.33333344e-007 + centerDepth);

  uint depthWidth;
  uint depthHeight;
  PS_TEXTURES_2D_0_.GetDimensions(depthWidth, depthHeight);

  const float2 aoResolution = float2(depthWidth, depthHeight) /* * 0.5 */; //depth & normal is 0.5x of render res, but AO output is also 0.5x
  const uint2 pixCoord = v1.xy * aoResolution;

  GTAOConstants gtao = (GTAOConstants)0;
  gtao.RenderPixelSize = rcp(aoResolution);
  gtao.ViewportPixelSize = gtao.RenderPixelSize;
  gtao.ViewportSize = aoResolution;

  // The VS exports v3 = float3(SSAO_FRUSTUM_SCALE.xy * (uv - 0.5), 1).
  // GTAO needs the same screen-to-view ray reconstruction for arbitrary sample pixels,
  // so derive it from the original frustum ray scale instead of guessing from the
  // projection inverse. The PS constant below is just the reciprocal projection scale
  // used for uv = view.xy / view.z * PS_REG_SSAO_FRUSTUM_SCALE.zw + 0.5.
  float2 frustumScale = SSAO_FRUSTUM_SCALE.xy;
  gtao.NDCToViewMul = frustumScale * gtao.RenderPixelSize;
  gtao.NDCToViewAdd = 0.5 * frustumScale.xy;
  gtao.NDCToViewMul_x_PixelSize = gtao.NDCToViewMul;

  gtao.EffectRadius = DVS1;
  gtao.RadiusMultiplier = DVS2;
  gtao.EffectFalloffRange = DVS3;
  gtao.SampleDistributionPower = DVS4;
  gtao.ThinOccluderCompensation = DVS5;
  gtao.FinalValuePower = 1.0;
  gtao.OcclusionTermScale = 1.0;
  gtao.DenoiseBlurBeta = 1.2;

  o0.x = XeGTAO_MainPass(pixCoord, localNoise, viewNormal, PS_TEXTURES_2D_0_, PS_SAMPLERS_3__s, gtao).x;

  /////////////////////////////

  #if HALO2_AO == 0
    o0.y = 0; //NOT USED!!!
  #else
    // Depth curvature edge-stopping term, used by the blur pass to avoid bleeding AO across depth discontinuities.
    float depthA0 = PS_TEXTURES_2D_0_.SampleLevel(PS_SAMPLERS_3__s, v1.xy - COMMON_VP_PARAMS[0].xy, 0).x;
    float depthA1 = PS_TEXTURES_2D_0_.SampleLevel(PS_SAMPLERS_3__s, v1.xy + COMMON_VP_PARAMS[0].xy, 0).x;
    float depthB0 = PS_TEXTURES_2D_0_.SampleLevel(PS_SAMPLERS_3__s, v1.xy - COMMON_VP_PARAMS[0].xy * float2(1, -1), 0).x;
    float depthB1 = PS_TEXTURES_2D_0_.SampleLevel(PS_SAMPLERS_3__s, v1.xy + COMMON_VP_PARAMS[0].xy * float2(1, -1), 0).x;

    float centerRemap = 0.100000016 / centerLinearDepth - 1.33333344e-007;
    float curvatureA = (depthA0 + depthA1) - 2.0 * centerRemap;
    float curvatureB = (depthB0 + depthB1) - 2.0 * centerRemap;

    float curvature = max(abs(curvatureA), abs(curvatureB)) * centerLinearDepth;
    o0.y = saturate(1.0 - curvature * 1024.0);
  #endif

  return;
}