// https://www.desmos.com/calculator/eudc3yupeo
float CalculateBlurFactor(float linearDepth, float4 params) 
{
  float blur = params.x - linearDepth;
  blur = -params.y + abs(blur);
  blur = max(0, blur);
  blur = blur * blur;
  blur = params.z * blur;
  blur = 1.44269502 * blur;
  blur = exp2(blur);
  blur = 1 - blur;
  blur = params.w * blur;
  return blur;
}

